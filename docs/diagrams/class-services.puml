@startuml
' Services and the Protocol interfaces they implement (src/core/protocols.py).
' Regenerated from code: uv run pyreverse src -o puml -p yetee -d docs/diagrams/generated
'
' Сервисы и реализуемые ими Protocol-интерфейсы (src/core/protocols.py).
' Регенерируется из кода: uv run pyreverse src -o puml -p yetee -d docs/diagrams/generated

skinparam classAttributeIconSize 0
hide empty members

' ---- Протоколы (src/core/protocols.py) ----
interface IConfigService
interface IEconomyService
interface IProjectService
interface ISettingsService
interface IUpdateService
interface IXmlRepository
interface ICache
interface IDetailPanel
interface IBatchPanel
interface IChipSet
interface ITableController
interface IPagination
interface ISearch
interface IDirtyState
interface IRemoteConnection {

' ---- UI Protocols / UI-протоколы ----
interface IEconomyEditor {
  + load_project(project)
  + unload()
}

' ---- Services ----
class ConfigService
class EconomyService
class ProjectService
class SettingsService {
  - page : ft.Page
  + load_settings()
  + save_setting(key, value)
}
class UpdateService
class EntertainmentService {
  edit_stats : dict
  total_edits : int
}
class FileCache
class XmlRepository
class EventRepository
class ConnectionManager {
  - _repository : ConnectionRepository
  + add(config, password)
  + remove(config_id)
  + set_active(config_id)
  + create(config) : IRemoteConnection
  + connect(config) / disconnect(config)
}
class RemoteSyncService {
  - _manager : ConnectionManager
  + sync_to_local(config, remote_dir, local_dir)
  + upload_to_remote(config, local_dir, remote_dir)
}

ConfigService ..|> IConfigService
EconomyService ..|> IEconomyService
ProjectService ..|> IProjectService
SettingsService ..|> ISettingsService
UpdateService ..|> IUpdateService
XmlRepository ..|> IXmlRepository
XmlRepository --> ICache : "depends"
EventRepository ..> ICache : "depends"
FileCache ..|> ICache
ConnectionManager --> IRemoteConnection : "create()"
RemoteSyncService --> ConnectionManager : "uses "

' DI wires everything (composition root, src/core/di.py)
FileDisplay ..> IXmlRepository
FileDisplay ..> ICache
EventDisplay ..> EventRepository

' EconomyService dereferences XML files through ConfigService
EconomyService --> ConfigService : "uses"

' Utilities / Утилиты
class xml_utils {
  + elem_text(parent, tag, default)
  + set_elem_text(parent, tag, value)
}

@enduml